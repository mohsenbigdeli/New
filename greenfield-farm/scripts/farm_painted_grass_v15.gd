extends RefCounted
class_name FarmPaintedGrassV15

const DATA: String = ""

static func texture() -> Texture2D:
	var raw: PackedByteArray = Marshalls.base64_to_raw(DATA)
	var image := Image.new()
	var err: Error = image.load_webp_from_buffer(raw)
	if err != OK:
		push_error("FarmPaintedGrassV15 decode failed: %s" % err)
		return null
	return ImageTexture.create_from_image(image)
